  "steps": [
    {"id":"s1","number":1,"phase":"Gel preparation","action":"Weigh agarose into a 500 mL flask and add 100 mL 1X TBE.","materialIds":["m1","m2"],"equipmentIds":["e1"],"tableIds":["t1"],"sourceReferences":[{"sourceId":"src1","excerpt":"Source direction 1."}]},
    {"id":"s2","number":2,"phase":"Gel preparation","action":"Mix gently and heat in a microwave until the agarose is completely dissolved.","equipmentIds":["e2"],"criticalNotes":"Wear protective gloves; use short heating intervals and avoid prolonged boiling.","sourceReferences":[{"sourceId":"src1","excerpt":"Source direction 2."}]},
    {"id":"s3","number":3,"phase":"Gel preparation","action":"Cool the hot agarose in a water bath, swirling occasionally.","equipmentIds":["e3"],"parameters":[{"type":"temperature","value":50,"valueMax":55,"unit":"°C","rawText":"50–55°C","sourceReferences":[{"sourceId":"src1","excerpt":"Source direction 3."}]},{"type":"time","value":10,"unit":"min","rawText":"10 min","sourceReferences":[{"sourceId":"src1","excerpt":"Source direction 3."}]}],"sourceReferences":[{"sourceId":"src1","excerpt":"Source direction 3."}]},
    {"id":"s4","number":4,"phase":"Casting","action":"Seal the gel tray ends with tape and place the 10-well comb in the tray on a level surface.","equipmentIds":["e4"],"criticalNotes":"A non-level surface can cause uneven gel thickness and migration.","sourceReferences":[{"sourceId":"src1","excerpt":"Source direction 4."}]},
    {"id":"s5","number":5,"phase":"Casting","action":"Add ethidium bromide stock to the cooled gel, pour into the tray, remove bubbles, and allow the gel to cool at room temperature.","materialIds":["m3"],"equipmentIds":["e4"],"parameters":[{"type":"volume","value":5,"unit":"µL","rawText":"5 µL stock ethidium bromide","sourceReferences":[{"sourceId":"src1","excerpt":"Source direction 5."}]},{"type":"time","value":30,"unit":"min","rawText":"30 min at room temperature","sourceReferences":[{"sourceId":"src1","excerpt":"Source direction 5."}]}],"safetyNotes":"The linked source identifies ethidium bromide as a known carcinogen.","sourceReferences":[{"sourceId":"src1","excerpt":"Source direction 5."}]},
    {"id":"s6","number":6,"phase":"Chamber setup","action":"Remove the comb and tape, place the tray in the electrophoresis chamber, and cover the gel with 1X TBE.","materialIds":["m2"],"equipmentIds":["e5"],"criticalNotes":"Cover the gel with approximately 2–3 mm of buffer.","sourceReferences":[{"sourceId":"src1","excerpt":"Source direction 6."}]},
    {"id":"s7","number":7,"phase":"Sample preparation","action":"Add loading buffer to the PCR sample and prepare the requested sample mass and loading volume.","materialIds":["m4","m5"],"tableIds":["t2"],"needsReview":true,"sourceReferences":[{"sourceId":"src1","excerpt":"Source direction 7."}]},
    {"id":"s8","number":8,"phase":"Loading","action":"Load diluted DNA ladder into the first and last wells, then load each prepared sample.","materialIds":["m4","m6","m7"],"tableIds":["t2"],"sourceReferences":[{"sourceId":"src1","excerpt":"Source direction 8."}]},
    {"id":"s9","number":9,"phase":"Electrophoresis","action":"Electrophorese the gel, ensuring that the current runs in the correct direction.","equipmentIds":["e5"],"parameters":[{"type":"voltage","value":100,"unit":"V","rawText":"100 V","sourceReferences":[{"sourceId":"src1","excerpt":"Source direction 9."}]},{"type":"time","value":40,"unit":"min","rawText":"40 min","sourceReferences":[{"sourceId":"src1","excerpt":"Source direction 9."}]}],"sourceReferences":[{"sourceId":"src1","excerpt":"Source direction 9."}]},
