  "steps": [
    {
      "id": "s1",
      "number": 1,
      "phase": "Gel preparation",
      "action": "Combine agarose and 1X TBE according to table t1, then heat in a microwave until the agarose dissolves.",
      "materialIds": ["m1", "m2"],
      "equipmentIds": ["e1"],
      "tableIds": ["t1"],
      "criticalNotes": "Use short heating intervals and avoid prolonged boiling; the source advises replacing lost water if needed.",
      "sourceReferences": [{"sourceId": "src1"}]
    },
    {
      "id": "s2",
      "number": 2,
      "phase": "Gel preparation",
      "action": "Cool the dissolved agarose in a water bath, swirling occasionally.",
      "equipmentIds": ["e2"],
      "parameters": [
        {
          "type": "temperature",
          "value": 50,
          "valueMax": 55,
          "unit": "°C",
          "rawText": "50–55°C",
          "sourceReferences": [{"sourceId": "src1"}]
        },
        {
          "type": "time",
          "value": 10,
          "unit": "min",
          "rawText": "10 min",
          "sourceReferences": [{"sourceId": "src1"}]
        }
      ],
      "sourceReferences": [{"sourceId": "src1"}]
    },
    {
      "id": "s3",
      "number": 3,
      "phase": "Casting",
      "action": "Prepare the casting tray and comb, add ethidium bromide to the cooled gel, pour the gel, and allow it to set.",
      "materialIds": ["m3"],
      "equipmentIds": ["e3"],
      "parameters": [
        {
          "type": "volume",
          "value": 5,
          "unit": "µL",
          "rawText": "5 µL ethidium bromide stock",
          "sourceReferences": [{"sourceId": "src1"}]
        },
        {
          "type": "time",
          "value": 30,
          "unit": "min",
          "rawText": "Cool for 30 min at room temperature.",
          "sourceReferences": [{"sourceId": "src1"}]
        }
      ],
      "safetyNotes": "The linked source identifies ethidium bromide as a known carcinogen.",
      "sourceReferences": [{"sourceId": "src1"}]
    },
    {
      "id": "s4",
      "number": 4,
      "phase": "Setup and loading",
      "action": "Place the gel in the chamber, cover it with 1X TBE, and load samples and ladder according to table t2.",
      "materialIds": ["m2", "m4", "m5", "m6", "m7"],
      "equipmentIds": ["e4"],
      "tableIds": ["t2"],
      "criticalNotes": "Cover the gel with approximately 2–3 mm of buffer.",
      "sourceReferences": [{"sourceId": "src1"}]
    },
