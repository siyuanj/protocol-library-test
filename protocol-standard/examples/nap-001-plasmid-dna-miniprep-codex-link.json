{
  "schemaVersion": "0.3",
  "metadata": {
    "title": "QIAprep Spin Miniprep Kit High-Yield Protocol",
    "protocolId": "nap-001-link",
    "version": "0.1",
    "family": "Nucleic acid purification",
    "category": "plasmid DNA miniprep",
    "discipline": "molecular biology",
    "purpose": "Purify up to 30 µg plasmid DNA using all eleven numbered steps in QIAGEN's linked high-yield protocol.",
    "scope": "High-copy plasmid DNA from 5 mL 2x YT culture grown to high density; QIAprep Spin Miniprep Kit catalog numbers 27104 and 27106.",
    "createdAt": "2026-08-22",
    "modifiedAt": "2026-08-22",
    "tags": ["plasmid", "miniprep", "QIAGEN", "link-derived", "source-step-mapped"]
  },
  "materials": [
    {"id":"m1","name":"Bacterial culture carrying plasmid","role":"sample","amount":5,"unit":"mL","specification":"2x YT culture","needsReview":true,"sourceReferences":[{"sourceId":"src1"}]},
    {"id":"m2","name":"Buffer P1 with RNase A","role":"buffer","storage":"2–8 °C after RNase A addition","sourceReferences":[{"sourceId":"src1"}]},
    {"id":"m3","name":"Buffer P2","role":"buffer","sourceReferences":[{"sourceId":"src1"}]},
    {"id":"m4","name":"Buffer N3","role":"buffer","sourceReferences":[{"sourceId":"src1"}]},
    {"id":"m5","name":"QIAprep spin column","role":"consumable","sourceReferences":[{"sourceId":"src1"}]},
    {"id":"m6","name":"Buffer PB","role":"buffer","sourceReferences":[{"sourceId":"src1"}]},
    {"id":"m7","name":"Buffer PE","role":"buffer","specification":"Ethanol (96–100%) added before use","sourceReferences":[{"sourceId":"src1"}]},
    {"id":"m8","name":"Buffer EB","role":"buffer","specification":"10 mM Tris·Cl, pH 8.5","sourceReferences":[{"sourceId":"src1"}]}
  ],
  "equipment": [{"id":"e1","name":"Table-top microcentrifuge","settings":"13,000 rpm (~17,900 × g) unless otherwise stated","sourceReferences":[{"sourceId":"src1"}]}],
  "software": [], "samples": [], "containers": [], "tables": [],
  "steps": [
    {"id":"s1","number":1,"phase":"Culture","action":"Inoculate 5 mL 2x YT with the bacterial strain and incubate the culture.","materialIds":["m1"],"parameters":[{"type":"temperature","value":37,"unit":"°C","rawText":"37°C","sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 1."}]},{"type":"time","value":12,"valueMax":16,"unit":"h","rawText":"12–16 h","sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 1."}]}],"criticalNotes":"Avoid overgrowth, which may reduce plasmid yields.","sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 1."}]},
    {"id":"s2","number":2,"phase":"Harvest","action":"Pellet the 5 mL bacterial culture by centrifugation at room temperature.","materialIds":["m1"],"equipmentIds":["e1"],"parameters":[{"type":"speed","value":6800,"comparator":"min","unit":"×g","rawText":">8000 rpm (6800 × g)","sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 2."}]},{"type":"time","value":3,"unit":"min","rawText":"3 min","sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 2."}]},{"type":"temperature","value":15,"valueMax":25,"unit":"°C","rawText":"room temperature (15–25°C)","sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 2."}]}],"sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 2."}]},
    {"id":"s3","number":3,"phase":"Resuspension","action":"Completely resuspend the cell pellet in Buffer P1 and transfer it to a microcentrifuge tube.","materialIds":["m2"],"parameters":[{"type":"volume","value":250,"unit":"µL","rawText":"250 µL Buffer P1","sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 3."}]}],"criticalNotes":"Ensure that no cell clumps remain.","sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 3."}]},
    {"id":"s4","number":4,"phase":"Lysis","action":"Add Buffer P2 and mix by inverting the tube 10–12 times until the solution turns completely blue, then incubate.","materialIds":["m3"],"parameters":[{"type":"volume","value":250,"unit":"µL","rawText":"250 µL Buffer P2","sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 4."}]},{"type":"count","valueText":"10–12","unit":"inversions","rawText":"Invert 10–12 times","sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 4."}]},{"type":"time","value":5,"unit":"min","rawText":"Do not allow lysis to proceed for more than 5 min.","sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 4."}]}],"sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 4."}]},
    {"id":"s5","number":5,"phase":"Neutralization","action":"Add Buffer N3 immediately and mix thoroughly by inverting 10–12 times until the solution turns colorless.","materialIds":["m4"],"parameters":[{"type":"volume","value":350,"unit":"µL","rawText":"350 µL Buffer N3","sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 5."}]}],"sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 5."}]},
    {"id":"s6","number":6,"phase":"Clarification","action":"Centrifuge the neutralized lysate.","equipmentIds":["e1"],"parameters":[{"type":"time","value":10,"unit":"min","rawText":"Centrifuge for 10 min.","sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 6."}]}],"sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 6."}]},
    {"id":"s7","number":7,"phase":"Binding","action":"Apply the supernatant from step 6 to the QIAprep spin column, centrifuge, and discard the flow-through.","materialIds":["m5"],"equipmentIds":["e1"],"parameters":[{"type":"time","value":30,"valueMax":60,"unit":"s","rawText":"Centrifuge for 30–60 s.","sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 7."}]}],"sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 7."}]},
    {"id":"s8","number":8,"phase":"Wash","action":"Wash the QIAprep spin column with Buffer PB and centrifuge as in step 7.","materialIds":["m5","m6"],"equipmentIds":["e1"],"parameters":[{"type":"volume","value":500,"unit":"µL","rawText":"500 µL Buffer PB","sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 8."}]}],"sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 8."}]},
    {"id":"s9","number":9,"phase":"Wash","action":"Wash the QIAprep spin column with Buffer PE, centrifuge as in step 7, and transfer the column to its collection tube.","materialIds":["m5","m7"],"equipmentIds":["e1"],"parameters":[{"type":"volume","value":750,"unit":"µL","rawText":"750 µL Buffer PE","sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 9."}]}],"sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 9."}]},
    {"id":"s10","number":10,"phase":"Dry spin","action":"Centrifuge the column to remove residual wash buffer.","equipmentIds":["e1"],"parameters":[{"type":"time","value":1,"unit":"min","rawText":"1 min","sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 10."}]}],"sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 10."}]},
    {"id":"s11","number":11,"phase":"Elution","action":"Place the QIAprep spin column in a clean microcentrifuge tube, add Buffer EB to the center of the membrane, let it stand, and centrifuge.","materialIds":["m5","m8"],"equipmentIds":["e1"],"parameters":[{"type":"volume","value":60,"unit":"µL","rawText":"60 µL Buffer EB","sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 11."}]},{"type":"time","value":1,"unit":"min","rawText":"Let stand for 1 min, then centrifuge for 1 min.","sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 11."}]}],"expectedResult":"Eluted plasmid DNA.","sourceReferences":[{"sourceId":"src1","excerpt":"Source procedure step 11."}]}
  ],
